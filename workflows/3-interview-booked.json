    {
      "parameters": {
        "jsCode": "// Turns the Settings tab (key | value rows) into one object.\nconst s = {};\nfor (const it of $input.all()) {\n  const k = String(it.json.key ?? '').trim();\n  if (k) s[k] = String(it.json.value ?? '').trim();\n}\nfor (const k of ['agency_name', 'recruiter_name', 'recruiter_email']) {\n  if (!s[k]) throw new Error(`Settings tab is missing a value for \"${k}\"`);\n}\nreturn [{ json: s }];\n"
      },
      "id": "228275e9-76c6-4862-b784-91fadbbce38e",
      "name": "Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.sheet_id }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Candidates",
          "mode": "name"
        },
        "options": {}
      },
      "id": "8804d72a-49dc-457b-a4f4-a2f4f4cea2b9",
      "name": "Read Candidates",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        880,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const body = $('Cal.com Webhook').first().json.body || {};\nconst ev = String(body.triggerEvent || '');\nconst p = body.payload || {};\nconst att = (p.attendees && p.attendees[0]) || {};\nconst meta = p.metadata || {};\nconst responses = p.responses || {};\nconst email = String(att.email || (responses.email && responses.email.value) || '').trim().toLowerCase();\nconst name = att.name || (responses.name && responses.name.value) || 'Someone';\nconst rows = $input.all().map(i => i.json).filter(r => r.candidate_id);\nlet row = meta.candidate_id ? rows.find(r => r.candidate_id === meta.candidate_id) : null;\nif (!row && email) row = rows.filter(r => String(r.email || '').trim().toLowerCase() === email)\n  .sort((a, b) => String(b.outreach_sent_at || '').localeCompare(String(a.outreach_sent_at || '')))[0];\nconst statusFor = { BOOKING_CREATED: 'Interview scheduled', BOOKING_RESCHEDULED: 'Interview scheduled', BOOKING_CANCELLED: 'Interview cancelled' };\nif (!statusFor[ev]) return [];   // ignore other Cal.com events\nconst meet = meta.videoCallUrl || (/^https?:/.test(String(p.location || '')) ? p.location : '');\nconst when = p.startTime || '';\nconst update = row ? { candidate_id: row.candidate_id, status: statusFor[ev], updated_at: new Date().toISOString(),\n  interview_time: ev === 'BOOKING_CANCELLED' ? '' : when, meet_link: ev === 'BOOKING_CANCELLED' ? '' : meet,\n  ...(ev === 'BOOKING_CREATED' ? { interview_booked_at: new Date().toISOString() } : {}),\n  ...(email && !row.email ? { email } : {}) } : null;\nconst verb = { BOOKING_CREATED: 'booked', BOOKING_RESCHEDULED: 'rescheduled', BOOKING_CANCELLED: 'cancelled' }[ev];\nconst esc = v => String(v ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst subject = `Interview ${verb}: ${name}` + (row ? ` (${row.role})` : '');\nconst html = `<p><b>${esc(name)}</b> (${esc(email)}) ${verb} an interview` + (when && ev !== 'BOOKING_CANCELLED' ? ` for <b>${esc(new Date(when).toUTCString())}</b>` : '') + `.</p>`\n  + (meet && ev !== 'BOOKING_CANCELLED' ? `<p>Meeting link: <a href=\"${esc(meet)}\">${esc(meet)}</a></p>` : '')\n  + (row ? `<p>Score ${esc(row.score)} - ${esc(row.summary)}<br><a href=\"${esc(row.linkedin_url)}\">LinkedIn profile</a></p>`\n         : '<p>This booking did not match anyone in the Candidates sheet, so the sheet was not updated.</p>');\nreturn [{ json: { matched: !!row, update, subject, html } }];\n"
      },
      "id": "a792f23c-b159-44b6-9102-6d9d82fbedcc",
      "name": "Match Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
